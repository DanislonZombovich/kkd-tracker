    <changeSet id="002-seed-rules-and-units" author="kkd-team">
        <comment>Seed rules, organizational units and demo data</comment>

        <!-- Rules -->
        <insert tableName="kkd_rules">
            <column name="code" value="GOAL_NO_OWNER"/>
            <column name="object_type" value="goal"/>
            <column name="severity" value="critical"/>
            <column name="title" value="Цель без ответственного"/>
            <column name="description" value="У активной цели не указан ответственный сотрудник."/>
            <column name="recommendation" value="Назначить ответственного за цель в модуле «Цели»."/>
        </insert>
        <insert tableName="kkd_rules">
            <column name="code" value="GOAL_NO_KR"/>
            <column name="object_type" value="goal"/>
            <column name="severity" value="critical"/>
            <column name="title" value="Цель без ключевых результатов"/>
            <column name="description" value="У активной цели нет ни одного ключевого результата."/>
            <column name="recommendation" value="Добавить 1–5 измеримых ключевых результатов."/>
        </insert>
        <insert tableName="kkd_rules">
            <column name="code" value="KR_WEIGHTS_SUM"/>
            <column name="object_type" value="goal"/>
            <column name="severity" value="major"/>
            <column name="title" value="Сумма весов КР не равна 100%"/>
            <column name="description" value="Сумма весов ключевых результатов цели отличается от 100%."/>
            <column name="recommendation" value="Перераспределить веса КР так, чтобы сумма была ровно 100%."/>
        </insert>
        <insert tableName="kkd_rules">
            <column name="code" value="CASCADE_NO_PARENT"/>
            <column name="object_type" value="goal"/>
            <column name="severity" value="major"/>
            <column name="title" value="Цель не связана с вышестоящей"/>
            <column name="description" value="Цель департамента, подразделения или сотрудника не привязана к цели вышестоящего уровня."/>
            <column name="recommendation" value="Указать родительскую цель вышестоящего уровня."/>
        </insert>
        <insert tableName="kkd_rules">
            <column name="code" value="KR_NO_TARGET"/>
            <column name="object_type" value="key_result"/>
            <column name="severity" value="major"/>
            <column name="title" value="КР без целевого значения"/>
            <column name="description" value="У ключевого результата не заполнено целевое значение."/>
            <column name="recommendation" value="Заполнить целевое значение КР."/>
        </insert>
        <insert tableName="kkd_rules">
            <column name="code" value="KR_STALE_PROGRESS"/>
            <column name="object_type" value="key_result"/>
            <column name="severity" value="minor"/>
            <column name="title" value="Прогресс КР давно не обновлялся"/>
            <column name="description" value="Фактическое значение КР не обновлялось более 45 дней."/>
            <column name="recommendation" value="Обновить фактическое значение КР."/>
        </insert>

