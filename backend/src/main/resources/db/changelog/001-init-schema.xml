<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-schema" author="kkd-team">
        <comment>Create core KKD tables and foreign keys</comment>

        <!-- 1. organizational_units -->
        <createTable tableName="organizational_units">
            <column name="id" type="VARCHAR(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="level" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="parent_id" type="VARCHAR(32)"/>
            <column name="depth" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="organizational_units" baseColumnNames="parent_id"
                                 constraintName="fk_units_parent"
                                 referencedTableName="organizational_units" referencedColumnNames="id"/>

        <!-- 2. goals -->
        <createTable tableName="goals">
            <column name="id" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="level" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="unit_id" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="owner_id" type="VARCHAR(64)"/>
            <column name="owner_name" type="VARCHAR(255)"/>
            <column name="parent_id" type="VARCHAR(64)"/>
            <column name="status" type="VARCHAR(32)" defaultValue="active">
                <constraints nullable="false"/>
            </column>
            <column name="deadline" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="goals" baseColumnNames="unit_id"
                                 constraintName="fk_goals_unit"
                                 referencedTableName="organizational_units" referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="goals" baseColumnNames="parent_id"
                                 constraintName="fk_goals_parent"
                                 referencedTableName="goals" referencedColumnNames="id"/>

        <!-- 3. key_results -->
        <createTable tableName="key_results">
            <column name="id" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="goal_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(500)">
                <constraints nullable="false"/>
            </column>
            <column name="target_value" type="NUMERIC(15, 2)"/>
            <column name="fact_value" type="NUMERIC(15, 2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="metric_unit" type="VARCHAR(32)"/>
            <column name="weight" type="NUMERIC(5, 2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="progress_updated_at" type="DATE">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="key_results" baseColumnNames="goal_id"
                                 constraintName="fk_kr_goal"
                                 referencedTableName="goals" referencedColumnNames="id"/>

        <!-- 4. kkd_rules -->
        <createTable tableName="kkd_rules">
            <column name="code" type="VARCHAR(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="object_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="severity" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="recommendation" type="VARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 5. kkd_runs -->
        <createTable tableName="kkd_runs">
            <column name="id" type="VARCHAR(32)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="run_no" type="INT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="snapshot_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="compared_to_run_id" type="VARCHAR(32)"/>
            <column name="started_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="finished_at" type="TIMESTAMP"/>
            <column name="error_message" type="VARCHAR(2000)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="kkd_runs" baseColumnNames="compared_to_run_id"
                                 constraintName="fk_runs_compared"
                                 referencedTableName="kkd_runs" referencedColumnNames="id"/>

        <!-- 6. kkd_issues -->
        <createTable tableName="kkd_issues">
            <column name="id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="run_id" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="fingerprint" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="rule_code" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="severity" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="object_type" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="object_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="goal_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="kr_id" type="VARCHAR(64)"/>
            <column name="unit_id" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="owner_id" type="VARCHAR(64)"/>
            <column name="owner_name" type="VARCHAR(255)"/>
            <column name="details" type="VARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="actual_value" type="VARCHAR(2000)"/>
            <column name="expected_value" type="VARCHAR(2000)"/>
            <column name="recommendation" type="VARCHAR(2000)">
                <constraints nullable="false"/>
            </column>
            <column name="delta_status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="runs_in_row" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey tableName="kkd_issues" columnNames="run_id, id" constraintName="pk_kkd_issues"/>

        <addForeignKeyConstraint baseTableName="kkd_issues" baseColumnNames="run_id"
                                 constraintName="fk_issues_run"
                                 referencedTableName="kkd_runs" referencedColumnNames="id"/>

        <addForeignKeyConstraint baseTableName="kkd_issues" baseColumnNames="rule_code"
                                 constraintName="fk_issues_rule"
                                 referencedTableName="kkd_rules" referencedColumnNames="code"/>

        <addForeignKeyConstraint baseTableName="kkd_issues" baseColumnNames="unit_id"
                                 constraintName="fk_issues_unit"
                                 referencedTableName="organizational_units" referencedColumnNames="id"/>

        <createIndex tableName="goals" indexName="idx_goals_unit">
            <column name="unit_id"/>
        </createIndex>
        <createIndex tableName="key_results" indexName="idx_kr_goal">
            <column name="goal_id"/>
        </createIndex>
        <createIndex tableName="kkd_issues" indexName="idx_issues_lookup">
            <column name="run_id"/>
            <column name="unit_id"/>
            <column name="rule_code"/>
        </createIndex>

        <!-- Rollback statements to enable clean rollback -> reapply -->
        <rollback>
            <dropTable tableName="kkd_issues"/>
            <dropTable tableName="kkd_runs"/>
            <dropTable tableName="kkd_rules"/>
            <dropTable tableName="key_results"/>
            <dropTable tableName="goals"/>
            <dropTable tableName="organizational_units"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
